{
	email admin@luxbrain.com.br
	# HTTP continua no ar mesmo enquanto o certificado ainda não foi emitido.
	auto_https disable_redirects
	# Mascara segredos também nos logs de erro do proxy.
	log default {
		format filter {
			wrap json
			fields {
				request>uri regexp "[?].*$" ""
				request>headers>X-Api-Key delete
				request>headers>X-Admin-Key delete
			}
		}
	}
}

# Proxy do gateway. O corpo de 11MiB vale só no envio de documentos;
# o restante de /gateway/api/* continua em 2MiB.
(proxy_gateway) {
	uri strip_prefix /gateway
	reverse_proxy luxbrain-gateway:8000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}
}

(gateway_https) {
	@gateway path /gateway /gateway/*
	handle @gateway {
		route {
			@inicio path /gateway /gateway/
			redir @inicio /gateway/health 308
			@documentos path /gateway/api/v1/documentos /gateway/api/v1/documentos/*
			handle @documentos {
				request_body {
					max_size 11MiB
				}
				import proxy_gateway
			}
			@publico path /gateway/health /gateway/health/ops /gateway/webhooks/* /gateway/api/*
			handle @publico {
				request_body {
					max_size 2MiB
				}
				import proxy_gateway
			}
			handle {
				respond 404
			}
		}
	}
}

(gateway_http) {
	@gateway_http path /gateway /gateway/*
	handle @gateway_http {
		redir https://painel.luxbrain.com.br{uri} 308
	}
}

(rotas) {
	encode gzip
	handle /auth/v1/* {
		uri strip_prefix /auth/v1
		reverse_proxy autenticacao:9999
	}
	handle /rest/v1/* {
		uri strip_prefix /rest/v1
		reverse_proxy api-rest:3000
	}
	# Simular documento chega aqui: POST /_serverFn/… com o arquivo em base64.
	# 15MB decimais cabem um arquivo de 10 MB (~14 MB em JSON) e recusam o que passar.
	handle /_serverFn/* {
		request_body {
			max_size 15MB
		}
		reverse_proxy painel:3000
	}
	handle {
		reverse_proxy painel:3000
	}
}

http://painel.luxbrain.com.br {
	import gateway_http
	import rotas
}

painel.luxbrain.com.br {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
		}
	}
	import gateway_https
	import rotas
}

:80 {
	import gateway_http
	import rotas
}
