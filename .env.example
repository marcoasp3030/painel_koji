# Copie para .env. O script docker/gerar-segredos.py preenche os valores.
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SITE_URL=https://painel.luxbrain.com.br
# Senha de uso único do primeiro Super Admin (admin@luxtia.local).
# Só é lida se essa conta ainda não existir. Deixe vazio quando a conta já foi criada.
# Não commite o valor.
BOOTSTRAP_SUPER_ADMIN_SENHA=
# Gateway. A chave de plataforma fica só no servidor e não entra no navegador.
GATEWAY_ADMIN_URL=
GATEWAY_PANEL_KEY=
GATEWAY_PLATFORM_KEY=
# MFA1: 0 até Marco e a conta de emergência terem fator + 10 códigos (ESPEC_MFA1 §9).
MFA1_OBRIGATORIO=0
# Vazio: o convite mostra um link de uso único para quem convidou.
# Preenchido: o convite volta a sair por e-mail. O serviço de autenticação
# também precisa de GOTRUE_SMTP_HOST, usuário, senha e porta.
SMTP_HOST=
